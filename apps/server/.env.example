# 由 @homurajs/core defineConfig 生成（配置即文档）

# 运行形态：'standalone' | 'qw-pages'；缺省自动探测
# HOMURA_RUNTIME=standalone  （不设=自动探测；显式 standalone 或 qw-pages）

# 监听端口
PORT=3000

# 监听地址（缺省 0.0.0.0）
HOST=

# 是否在反向代理后（决定 cookie Secure 与 X-Forwarded-* 可信度）
TRUST_PROXY=false

# 数据方言：'sqlite' | 'pg' | 'rest'（缺省 sqlite）
DB_DIALECT=sqlite

# sqlite 数据库文件路径（dialect=sqlite 时用）
DB_PATH=./data/app.db

# PostgreSQL 连接串（dialect=pg 时必填）
DATABASE_URL=<redacted>

# PostgREST/Supabase URL（dialect=rest 时必填；qw-pages 自动注入）
SUPABASE_URL=

# Supabase anon key（dialect=rest 时必填）
SUPABASE_ANON_KEY=<redacted>

# session HS256 签名密钥（>=32 bytes，必填）
SESSION_SECRET=<redacted>

# local-fs 存储后端根目录
STORAGE_ROOT=./data/files

# 前端静态资源目录（缺省由 RuntimeAdapter.assetsDir 按形态算）
HOMURA_ASSETS_DIR=

# CORS 允许的来源（逗号分隔）；修复现有硬编码 localhost 缺陷
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 钉钉集成（全部可选；不配则钉钉功能降级停用）──────────────────
# 钉钉企业应用 AppKey（配置即启用推送与通讯录同步能力）
DINGTALK_APP_KEY=
# 钉钉企业应用 AppSecret
DINGTALK_APP_SECRET=<redacted>
# 钉钉工作通知 agentId（asyncsend_v2 必需；无法从 AppKey 反推，需后台查看或调 GET /dingtalk/apps）
DINGTALK_AGENT_ID=
# oauth2-dingtalk 组织标识（与 OAUTH_CLIENT_ID/SECRET/REDIRECT_URI 配齐即启用钉钉扫码登录）
OAUTH_DINGTALK_ORG_ID=
# oauth2-dingtalk 部署地址（缺省线上 dingtalk.auth.xrl.im）
OAUTH_DINGTALK_BASE_URL=
# OAuth2 客户端 id / 密钥（oauth2-dingtalk 侧登记）
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=<redacted>
# OAuth2 回调地址（本地开发须写 :5173 走 Vite proxy，否则 cookie 落错域）
OAUTH_REDIRECT_URI=

# 日志级别：'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

